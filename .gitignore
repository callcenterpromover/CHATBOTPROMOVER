node_modules/
.next/
__pycache__/
.venv/

# Herramientas locales (entorno de graphify)
.tools/

# Grafo de graphify (local, se regenera)
graphify-out/

# Calibracion del OCR: imagenes reales de pacientes. NUNCA subir.
calibracion/
calibracion*.7z
calibracion*.zip
