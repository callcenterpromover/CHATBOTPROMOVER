# Copiar como .env (no se sube a git) y completar.
SUPABASE_URL=https://<ref>.supabase.co
# Clave SECRETA del proyecto (sb_secret_...). Da acceso total a los datos: solo en este equipo.
SUPABASE_SECRET_KEY=

# Token de la API de WhatsApp (Meta) para descargar los documentos. Se completa en la Fase 3.
META_WHATSAPP_TOKEN=
META_API_VERSION=v23.0

# Panel (Vercel) al que se avisa cuando termina un documento, y el secreto compartido con él
# (mismo valor que WORKER_SECRET en Vercel, 32 caracteres o más).
PANEL_URL=https://chatbotpromover.vercel.app
WORKER_SECRET=

# 1 solo para pruebas con documentos ficticios de worker/entrada. En operación real debe ser 0.
PERMITIR_FUENTE_LOCAL=0

# Opcionales
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# INTERVALO_SEGUNDOS=10

# WhatsApp vía Kapso: para descargar las fotos que envían los pacientes.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
