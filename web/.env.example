# Copiar como .env.local y completar.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Secreto compartido con el worker (32+ caracteres; mismo valor en worker/.env).
WORKER_SECRET=
# 1 = muestra el simulador de WhatsApp en el panel. Debe ser 0 cuando haya pacientes reales.
MODO_SIMULACION=1

# WhatsApp (Meta Cloud API), cuando exista la cuenta.
# META_VERIFY_TOKEN=     (texto que tú inventas y pones también en Meta al registrar el webhook)
# META_APP_SECRET=       (App Secret de la app de Meta: valida la firma de cada mensaje)
# META_PHONE_NUMBER_ID=
# META_WHATSAPP_TOKEN=
# META_API_VERSION=v23.0
